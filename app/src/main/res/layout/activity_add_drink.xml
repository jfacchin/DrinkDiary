<?xml version="1.0" encoding="utf-8"?>
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp"
        >

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="24dp"
            android:text="Add a Drink"
            android:textSize="26sp"
            android:textStyle="bold" />

        <Spinner
            android:id="@+id/drink_type"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
             />

        <EditText
            android:id="@+id/editTextDrinkName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Drink name"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/editTextCafe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Café"
            android:inputType="textCapWords" />

        <EditText
            android:id="@+id/editTextPrice"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Price"
            android:inputType="numberDecimal" />

        <EditText
            android:id="@+id/editTextRating"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Rating from 1–5"
            android:inputType="number" />

        <!-- edit notes section -->
        <EditText
            android:id="@+id/editTextNotes"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:hint="Notes (Optional)"
            android:inputType="textMultiLine"
            android:minLines="2"
            android:layout_gravity="top|start"
            />
        <!-- text for before the allergen selection -->
        <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
        android:text="Select Allergens"

       />
<!-- implementing the chip group for the allergen section-->

        <com.google.android.material.chip.ChipGroup
            android:id="@+id/allergenGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            app:singleSelection="false"
            app:selectionRequired="false"/>


     <!-- save button -->

        <Button
            android:id="@+id/buttonSaveDrink"
            android:layout_width="357dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Save Drink" />

        <Switch
            android:id="@+id/woaSwitch"
            android:layout_width="360dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:text="Would Order Again"
            tools:ignore="UseSwitchCompatOrMaterialXml" />

    </LinearLayout>

</ScrollView>