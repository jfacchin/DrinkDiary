<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/drink_cream">

    <ScrollView
        android:id="@+id/detailScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toTopOf="@id/detailBottomBar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="24dp"
            android:paddingTop="18dp"
            android:paddingEnd="24dp"
            android:paddingBottom="24dp">

            <!-- Screen title -->

            <TextView
                android:id="@+id/detailTitleText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Drink Details"
                android:textColor="@color/drink_brown"
                android:textSize="30sp"
                android:textStyle="bold" />

            <!-- Photo and watercolor area -->

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="170dp"
                android:layout_marginTop="6dp">

                <ImageView
                    android:layout_width="300dp"
                    android:layout_height="145dp"
                    android:layout_gravity="center"
                    android:alpha="0.85"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:scaleType="fitXY"
                    android:src="@drawable/watercolor_swoosh_wide" />

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="105dp"
                    android:layout_height="135dp"
                    android:layout_gravity="center"
                    app:cardBackgroundColor="@color/drink_sage"
                    app:cardCornerRadius="30dp"
                    app:cardElevation="0dp">

                    <ImageView
                        android:id="@+id/detailDrinkImage"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:contentDescription="Drink photo"
                        android:padding="16dp"
                        android:scaleType="centerCrop"
                        android:src="@drawable/ic_launcher_foreground" />

                </com.google.android.material.card.MaterialCardView>

            </FrameLayout>

            <!-- Main drink information card -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/detailInformationCard"
                android:layout_width="match_parent"
                android:layout_height="340dp"
                app:cardBackgroundColor="@color/drink_tan"
                app:cardCornerRadius="32dp"
                app:cardElevation="0dp"
                app:strokeColor="@color/drink_sage"
                app:strokeWidth="1dp">

                <androidx.constraintlayout.widget.ConstraintLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:padding="18dp">

                    <!-- Delete button -->

                    <com.google.android.material.button.MaterialButton
                        android:id="@+id/buttonDeleteDrink"
                        android:layout_width="44dp"
                        android:layout_height="44dp"
                        android:contentDescription="Delete drink"
                        android:gravity="center"
                        android:minHeight="0dp"
                        android:minWidth="0dp"
                        android:padding="0dp"
                        android:text="×"
                        android:textColor="@color/drink_white"
                        android:textSize="27sp"
                        app:backgroundTint="@color/drink_caramel"
                        app:cornerRadius="22dp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <!-- Drink name -->

                    <TextView
                        android:id="@+id/drinkNameLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="18dp"
                        android:text="Drink Name:"
                        android:textColor="@color/drink_brown"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toTopOf="parent" />

                    <TextView
                        android:id="@+id/detailDrinkName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:layout_marginEnd="8dp"
                        android:textColor="@color/drink_brown"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toStartOf="@id/buttonDeleteDrink"
                        app:layout_constraintStart_toEndOf="@id/drinkNameLabel"
                        app:layout_constraintTop_toTopOf="@id/drinkNameLabel"
                        tools:text="Earl Grey Matcha" />

                    <!-- Cafe name -->

                    <TextView
                        android:id="@+id/cafeNameLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Cafe Name:"
                        android:textColor="@color/drink_brown"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/drinkNameLabel" />

                    <TextView
                        android:id="@+id/detailCafeName"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textColor="@color/drink_brown"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/cafeNameLabel"
                        app:layout_constraintTop_toTopOf="@id/cafeNameLabel"
                        tools:text="Tastea Cafe" />

                    <!-- Price -->

                    <TextView
                        android:id="@+id/priceLabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:text="Price:"
                        android:textColor="@color/drink_brown"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/cafeNameLabel" />

                    <TextView
                        android:id="@+id/detailPrice"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:textColor="@color/drink_brown"
                        android:textSize="14sp"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/priceLabel"
                        app:layout_constraintTop_toTopOf="@id/priceLabel"
                        tools:text="$8.50" />

                    <!-- Notes card -->

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/detailNotesCard"
                        android:layout_width="130dp"
                        android:layout_height="110dp"
                        android:layout_marginTop="22dp"
                        app:cardBackgroundColor="@color/drink_caramel"
                        app:cardCornerRadius="22dp"
                        app:cardElevation="0dp"
                        app:layout_constraintStart_toStartOf="parent"
                        app:layout_constraintTop_toBottomOf="@id/priceLabel">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="12dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="Notes"
                                android:textColor="@color/drink_white"
                                android:textSize="13sp"
                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/detailNotesText"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="7dp"
                                android:gravity="center"
                                android:textColor="@color/drink_white"
                                android:textSize="12sp"
                                tools:text="Nice Earl Grey flavor" />

                        </LinearLayout>

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Would order again -->

                    <TextView
                        android:id="@+id/wouldOrderAgainLabel"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="18dp"
                        android:gravity="center"
                        android:text="Would order again?"
                        android:textColor="@color/drink_brown"
                        android:textSize="13sp"
                        android:textStyle="bold"
                        app:layout_constraintEnd_toEndOf="parent"
                        app:layout_constraintStart_toEndOf="@id/detailNotesCard"
                        app:layout_constraintTop_toTopOf="@id/detailNotesCard" />

                    <com.google.android.material.card.MaterialCardView
                        android:id="@+id/detailWouldOrderAgainCard"
                        android:layout_width="54dp"
                        android:layout_height="54dp"
                        android:layout_marginTop="14dp"
                        app:cardBackgroundColor="@color/drink_sage"
                        app:cardCornerRadius="27dp"
                        app:cardElevation="0dp"
                        app:layout_constraintEnd_toEndOf="@id/wouldOrderAgainLabel"
                        app:layout_constraintStart_toStartOf="@id/wouldOrderAgainLabel"
                        app:layout_constraintTop_toBottomOf="@id/wouldOrderAgainLabel">

                        <TextView
                            android:id="@+id/detailWouldOrderAgainText"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:gravity="center"
                            android:text="✓"
                            android:textColor="@color/drink_brown"
                            android:textSize="30sp"
                            android:textStyle="bold" />

                    </com.google.android.material.card.MaterialCardView>

                    <!-- Rating -->

                    <TextView
                        android:id="@+id/detailRatingText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/drink_brown"
                        android:textSize="20sp"
                        android:textStyle="bold"
                        app:layout_constraintBottom_toBottomOf="parent"
                        app:layout_constraintEnd_toEndOf="parent"
                        tools:text="4.5 / 5" />

                </androidx.constraintlayout.widget.ConstraintLayout>

            </com.google.android.material.card.MaterialCardView>

        </LinearLayout>

    </ScrollView>

    <!-- Bottom Save/Edit bar -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/detailBottomBar"
        android:layout_width="0dp"
        android:layout_height="70dp"
        app:cardBackgroundColor="@color/drink_tan"
        app:cardCornerRadius="24dp"
        app:cardElevation="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonSaveDetails"
                android:layout_width="110dp"
                android:layout_height="44dp"
                android:layout_marginStart="18dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Save"
                android:textAllCaps="false"
                android:textColor="@color/drink_brown"
                android:textSize="15sp"
                app:backgroundTint="@color/drink_caramel"
                app:cornerRadius="22dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/buttonEditDrink"
                android:layout_width="110dp"
                android:layout_height="44dp"
                android:layout_marginEnd="18dp"
                android:minHeight="0dp"
                android:minWidth="0dp"
                android:text="Edit"
                android:textAllCaps="false"
                android:textColor="@color/drink_brown"
                android:textSize="15sp"
                app:backgroundTint="@color/drink_caramel"
                app:cornerRadius="22dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

</androidx.constraintlayout.widget.ConstraintLayout>