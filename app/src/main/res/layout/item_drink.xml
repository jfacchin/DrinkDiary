<?xml version="1.0" encoding="utf-8"?>

<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="182dp"
    android:layout_margin="7dp"
    android:clipChildren="false"
    android:clipToPadding="false">

    <!-- Outer tan drink card -->

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/drinkOuterCard"
        android:layout_width="match_parent"
        android:layout_height="170dp"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="@color/drink_tan"
        app:cardCornerRadius="26dp"
        app:cardElevation="0dp"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:padding="10dp">

            <!-- Drink photo -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/drinkImageCard"
                android:layout_width="58dp"
                android:layout_height="82dp"
                android:layout_marginTop="12dp"
                app:cardBackgroundColor="@color/drink_sage"
                app:cardCornerRadius="16dp"
                app:cardElevation="0dp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

                <ImageView
                    android:id="@+id/drinkImage"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:contentDescription="Drink photo"
                    android:padding="10dp"
                    android:scaleType="fitCenter"
                    android:src="@drawable/ic_launcher_foreground"
                    app:tint="@color/drink_brown" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Drink name -->

            <TextView
                android:id="@+id/drinkNameText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:textColor="@color/drink_brown"
                android:textSize="15sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/drinkImageCard"
                app:layout_constraintTop_toTopOf="@id/drinkImageCard"
                tools:text="Earl Grey Matcha" />

            <!-- Cafe name -->

            <TextView
                android:id="@+id/drinkCafeText"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_marginTop="5dp"
                android:textColor="@color/drink_brown"
                android:textSize="11sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/drinkImageCard"
                app:layout_constraintTop_toBottomOf="@id/drinkNameText"
                tools:text="Tastea Cafe" />

            <!-- Rating -->

            <TextView
                android:id="@+id/drinkRatingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="6dp"
                android:textColor="@color/drink_brown"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                tools:text="4.5 / 5" />

            <!-- Would order again -->

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/wouldOrderAgainCard"
                android:layout_width="42dp"
                android:layout_height="42dp"
                app:cardBackgroundColor="@color/drink_sage"
                app:cardCornerRadius="21dp"
                app:cardElevation="0dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/wouldOrderAgainText"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:gravity="center"
                    android:text="✓"
                    android:textColor="@color/drink_brown"
                    android:textSize="23sp"
                    android:textStyle="bold" />

            </com.google.android.material.card.MaterialCardView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </com.google.android.material.card.MaterialCardView>

    <!-- Separate ribbon layered across the outer card border -->

    <ImageView
        android:id="@+id/drinkRibbon"
        android:layout_width="88dp"
        android:layout_height="23dp"
        android:elevation="20dp"
        android:rotation="-7"
        android:scaleType="fitXY"
        android:src="@drawable/ribbon"
        android:translationY="11dp"
        android:translationZ="20dp"
        app:layout_constraintBottom_toTopOf="@id/drinkOuterCard"
        app:layout_constraintEnd_toEndOf="@id/drinkOuterCard"
        app:layout_constraintStart_toStartOf="@id/drinkOuterCard" />

</androidx.constraintlayout.widget.ConstraintLayout>